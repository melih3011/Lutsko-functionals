 RowBox[{
  RowBox[{"\[Phi]1", "[", "n3_", "]"}], ":=", 
  RowBox[{"1", "+", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"2", "*", "n3"}], "-", 
      RowBox[{"n3", "^", "2"}], "+", 
      RowBox[{"2", "*", 
       RowBox[{"(", 
        RowBox[{"1", "-", "n3"}], ")"}], "*", 
       RowBox[{"Log", "[", 
        RowBox[{"1", "-", "n3"}], "]"}]}]}], ")"}], "/", 
    RowBox[{"(", 
     RowBox[{"3", "*", "n3"}], ")"}]}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Phi]2", "[", "n3_", "]"}], ":=", 
  RowBox[{"1", "-", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"2", "*", "n3"}], "-", 
      RowBox[{"3", "*", 
       RowBox[{"n3", "^", "2"}]}], "+", 
      RowBox[{"2", "*", 
       RowBox[{"n3", "^", "3"}]}], "+", 
      RowBox[{"2", "*", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", "-", "n3"}], ")"}], "^", "2"}], "*", 
       RowBox[{"Log", "[", 
        RowBox[{"1", "-", "n3"}], "]"}]}]}], ")"}], "/", 
    RowBox[{"(", 
     RowBox[{"3", "*", 
      RowBox[{"n3", "^", "2"}]}], ")"}]}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"phi", "[", 
   RowBox[{
   "n0_", ",", "n1_", ",", "n2_", ",", "n3_", ",", "n1v_", ",", "n2v_", ",", 
    "nt1_", ",", "nt2_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{
    RowBox[{"-", "n0"}], "*", 
    RowBox[{"Log", "[", 
     RowBox[{"1", "-", "n3"}], "]"}]}], " ", "+", " ", 
   RowBox[{
    RowBox[{"\[Phi]1", "[", "n3", "]"}], "*", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"n1", "*", "n2"}], "-", 
       RowBox[{"n1v", "*", "n2v"}]}], ")"}], "/", 
     RowBox[{"(", 
      RowBox[{"1", "-", "n3"}], ")"}]}]}], " ", "+", " ", 
   RowBox[{
    RowBox[{"\[Phi]2", "[", "n3", "]"}], "*", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"n2", "^", "3"}], "-", 
       RowBox[{"3", "*", "n2", "*", 
        RowBox[{"n2v", "^", "2"}]}]}], ")"}], "/", 
     RowBox[{"(", 
      RowBox[{"24", "*", "Pi", "*", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", "-", "n3"}], ")"}], "^", "2"}]}], 
      ")"}]}]}]}]}], "\[IndentingNewLine]", 
 RowBox[{"f", " ", "=", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"\[Eta]", "*", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"Log", "[", 
         RowBox[{"C", "*", "\[Eta]"}], "]"}], "-", "1"}], ")"}]}], "+", 
     RowBox[{
      RowBox[{"Pi", "/", "6"}], "*", 
      RowBox[{"\[Sigma]", "^", "3"}], "*", 
      RowBox[{"phi", "[", 
       RowBox[{
       "n0", ",", "n1", ",", "n2", ",", "n3", ",", "n1v", ",", "n2v", ",", 
        "nt1", ",", "nt2"}], "]"}]}]}], "/.", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"n0", "\[Rule]", 
       RowBox[{"6", "*", 
        RowBox[{"\[Eta]", "/", 
         RowBox[{"(", 
          RowBox[{"\[Pi]", "*", 
           RowBox[{"\[Sigma]", "^", "3"}]}], ")"}]}]}]}], ",", 
      RowBox[{"n1", "\[Rule]", 
