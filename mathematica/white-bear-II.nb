Cell[CellGroupData[{
Cell["White-Bear-Mark II Functional", "Title",
 CellChangeTimes->{{3.948953352070134*^9, 
  3.948953384599772*^9}},ExpressionUUID->"e69505ff-f36b-4d9d-9b26-\
f1647defd78d"],

Cell[TextData[{
 "The White-Bear mark II functional ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    TemplateBox[<|"boxes" -> FormBox[
        RowBox[{"\[CapitalPhi]", "(", 
          SubscriptBox[
           StyleBox["n", "TI"], "\[Alpha]"], ")"}], TraditionalForm], 
      "errors" -> {}, "input" -> "\\Phi({n_\\alpha})", "state" -> "Boxes"|>,
     "TeXAssistantTemplate"], " "}], TraditionalForm]],ExpressionUUID->
  "9029a32c-9291-40f4-9312-a9b0c2467496"],
 "is obtained using a more accurate equation of state for hard-sphere \
mixtures.\nIt takes the form\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[CapitalPhi]", "\[LongEqual]", "-", 
         SubscriptBox[
          StyleBox["n", "TI"], "0"], "log", 
         RowBox[{"(", 
           RowBox[{"1", "-", 
             SubscriptBox[
              StyleBox["n", "TI"], "3"]}], ")"}], "+", 
         SubscriptBox["\[CurlyPhi]", "1"], 
         RowBox[{"(", 
           SubscriptBox[
            StyleBox["n", "TI"], "3"], ")"}], 
         FractionBox[
          RowBox[{
            SubscriptBox[
             StyleBox["n", "TI"], "1"], 
            SubscriptBox[
             StyleBox["n", "TI"], "2"], "-", 
            SubscriptBox[
             StyleBox["n", FontSlant -> "Bold"], "1"], 
            SubscriptBox[
             StyleBox["n", FontSlant -> "Bold"], "2"]}], 
          RowBox[{"1", "-", 
            SubscriptBox[
             StyleBox["n", "TI"], "3"]}]], "+", 
         SubscriptBox["\[CurlyPhi]", "2"], 
         RowBox[{"(", 
           SubscriptBox[
            StyleBox["n", "TI"], "3"], ")"}], 
         FractionBox[
          RowBox[{
            SubscriptBox[
             StyleBox["n", "TI"], "2"], "(", 
            RowBox[{
              SubsuperscriptBox[
               StyleBox["n", "TI"], "2", "2"], "-", "3", 
              SubsuperscriptBox[
               StyleBox["n", FontSlant -> "Bold"], "2", "2"]}], ")"}], 
          RowBox[{"24", "\[Pi]", 
            SuperscriptBox[
             RowBox[{"(", 
               RowBox[{"1", "-", 
                 SubscriptBox[
                  StyleBox["n", "TI"], "3"]}], ")"}], "2"]}]]}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "\\Phi = -n_0\\log(1-n_3) +\\varphi_1(n_3)\\frac{n_1 n_2 - \\mathbf{n}_1 \
\\mathbf{n}_2}{1-n_3} + \\varphi_2(n_3)\\frac{n_2(n_2^2-3\\mathbf{n}_2^2)}{24\
\\pi(1-n_3)^2}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "98c989ba-d9ac-418b-b6c8-c8203a652035"]
}], "Text",
 CellChangeTimes->{{3.948953403820619*^9, 
  3.948953542991497*^9}},ExpressionUUID->"c1f2bc21-7998-4206-b817-\
048b6f3dd629"],

